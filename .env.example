# Copy to .env and fill in. Never commit .env.
# Tiger Data (TimescaleDB) connection string. Empty -> local SQLite at data/smellcast.sqlite
DATABASE_URL=
# 1 = serve the seeded demo snapshot instead of live sources
DEMO_MODE=0
# Bright Data
BRIGHTDATA_SCRAPING_BROWSER_WSS=
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Email (Resend)
RESEND_API_KEY=
ALERT_FROM_EMAIL=
PUBLIC_BASE_URL=http://localhost:8000
# Admin form for manual flow events
ADMIN_TOKEN=
# Default river flow (MGD) when no gauge data is available
DEFAULT_FLOW_MGD=35
DOMAIN=
MODEL_WORKERS=4
