# Copy to .env and fill in. Never commit .env.
# Tiger Data (TimescaleDB) connection string.
# Empty -> docker compose: the local TimescaleDB container; bare python: local SQLite at data/smellcast.sqlite.
# Bare python against the compose database: postgresql://smellcast:smellcast@localhost:5433/smellcast
DATABASE_URL=
# 1 = serve the seeded demo snapshot instead of live sources
DEMO_MODE=0
# Seed the database on container start (scripts/seed.py): 1 = once, small = same with the Replay list capped at 5 bad nights,
# always = every start, 0 = off.
# The flow step accepts the USIBWC Water Data Portal disclaimer; the reports step spends Bright Data credit.
SEED=0
SEED_ARGS=
# Replay list: seeded = only the nights the seed picked (when it has run), all = every night with readings.
REPLAY_LIST=seeded
# Bright Data
BRIGHTDATA_SCRAPING_BROWSER_WSS=
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Email: Resend when RESEND_API_KEY is set; otherwise SMTP (docker compose points this at Mailpit,
# inbox at http://localhost:8025). Bare python + compose Mailpit: SMTP_HOST=localhost
RESEND_API_KEY=
ALERT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=1025
PUBLIC_BASE_URL=http://localhost:8000
# Admin form for manual flow events
ADMIN_TOKEN=
# Default river flow (MGD) when no gauge data is available
DEFAULT_FLOW_MGD=35
# HTTPS domain for the production `--profile https` Caddy service
DOMAIN=
MODEL_WORKERS=4
FIGMA_TOKEN=
